# Copy to .env (cp .env.example .env && chmod 600 .env) or run `npm run setup`. Real environment variables override .env.

# Required: custom app credentials from the Lark developer console (Credentials & Basic Info).
LARK_APP_ID=cli_0000000000000000
LARK_APP_SECRET=replace-with-your-app-secret
# lark (default, open.larksuite.com), feishu (open.feishu.cn), or an https base URL on a Lark/Feishu host.
LARK_DOMAIN=lark

# Required: HTTPS endpoint that receives one JSON POST per forwarded message (e.g. a Grok Bot routine's Webhook URL),
# and the full Authorization header value sent with it (for a Grok Bot routine: "Bearer <key>").
# The bridge refuses to start without both.
FORWARD_WEBHOOK_URL=https://example.com/your-webhook
FORWARD_WEBHOOK_AUTH="Bearer replace-with-your-token"

# Owner protection (off by default): on forwards only the bound owner (+ ALLOWLIST), rate-limited, marked
# untrusted. off forwards every sender, no binding, and marks EVERY payload trusted (untrusted=false).
OWNER_PROTECTION=off
# Optional explicit owner open_id (ou_...); ./senders.sh lists recent sender open_ids. Without it (protection on),
# the FIRST account that messages the bot becomes the owner.
OWNER_ID=
# Optional comma-separated extra open_ids allowed when protection is on.
ALLOWLIST=
# Per-sender messages per minute when protection is on (0 disables).
RATE_LIMIT_PER_MIN=20
# Messages per minute from all senders together, in both modes (0 disables).
GLOBAL_RATE_LIMIT_PER_MIN=60
# Longer inbound messages are truncated (0 disables).
MAX_MESSAGE_CHARS=4000

# Passed to the receiving agent as "mirror" in every payload: should it copy channel conversations to its main chat?
MIRROR_TO_MAIN_CHAT=true

# Group chats: forward only messages that @mention the bot (default true).
GROUP_REQUIRE_MENTION=true

# Inbound images, files, audio and video: downloaded with the message resource API into MEDIA_DIR and listed in
# the payload's "media" array. false: no downloads and no "media" array.
ACCEPT_MEDIA=true
# Optional media settings (defaults shown): directory, per-file cap in MB, retention in days (0 keeps files).
# MEDIA_DIR=state/media
# MEDIA_MAX_MB=100
# MEDIA_RETENTION_DAYS=7
# Optional: reply.sh only sends files from these directories (colon- or comma-separated). Secrets are always refused.
# REPLY_ALLOWED_DIRS=

# Healthcheck: report STALE when the long connection showed no sign of life for this many seconds.
HEALTH_STALE_SECONDS=180
# Optional locations (default: ./state and ./logs).
# STATE_DIR=state
# LOG_DIR=logs
# On stop, milliseconds that messages in progress may take to finish (unfinished ones go to undelivered.jsonl).
# BRIDGE_STOP_GRACE_MS=10000
# Allow a plain-http webhook on a non-localhost host (not recommended).
# FORWARD_ALLOW_INSECURE_HTTP=0
